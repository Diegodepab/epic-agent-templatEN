  "frontend-dataviz-and-charts": {
    "triggers": {
      "positive_keywords": ["chart encodings", "synonym lookup", "G6 v5"],
      "negative_keywords": ["games"]
    },
    "cases": [
      {
        "id": "valid_taxonomy_search",
        "kind": "valid",
        "cmd": ["python3", "{SKILL}/scripts/chart_advisor.py", "search", "--query", "sankey conversion"],
        "check_read_only": true,
        "expect_rc": 0,
        "expect_in": ["sankey"]
      },
      {
        "id": "invalid_g6_v4_antipattern_detected",
        "kind": "invalid",
        "files": {"src/graph.ts": "import { G6 } from '@antv/g6';\nconst g = new G6.Graph({ nodeStrength: -5 });\n"},
        "cmd": ["python3", "{SKILL}/scripts/chart_advisor.py", "audit", "--target", "src"],
        "check_read_only": true,
        "expect_rc": 1,
        "expect_in": ["new G6.Graph", "nodeStrength"]
