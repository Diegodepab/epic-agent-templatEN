  "brand-logo-and-svg-forge": {
    "triggers": {
      "positive_keywords": ["SVG", "favicon.ico", "README"],
      "negative_keywords": ["sprite sheets"]
    },
    "cases": [
      {
        "id": "valid_svg_audit_clean",
        "kind": "clean_fp",
        "files": {"mark.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 256 256\" width=\"256\" height=\"256\"><title>Clean</title><path fill=\"#0F7C80\" fill-rule=\"evenodd\" d=\"M32 32h192v192H32zM76 76h104v104H76z\"/></svg>\n"},
        "cmd": ["python3", "{SKILL}/scripts/svg_audit.py", "mark.svg", "--bg", "#ffffff"],
        "check_read_only": true,
        "expect_rc": 0,
        "expect_in": ["100/100"]
      },
      {
        "id": "invalid_live_text_caught",
        "kind": "invalid",
        "files": {"bad.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 100 100\"><text x=\"10\" y=\"50\">X</text></svg>\n"},
        "cmd": ["python3", "{SKILL}/scripts/svg_audit.py", "bad.svg"],
        "check_read_only": true,
        "expect_rc": 0,
        "expect_in": ["live-text"]
      },
      {
        "id": "valid_png_and_web_icons_inkscape",
        "kind": "valid",
        "requires_bin": "inkscape",
        "files": {"mark.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 256 256\" width=\"256\" height=\"256\"><title>Clean</title><rect x=\"32\" y=\"32\" width=\"192\" height=\"192\" fill=\"#0F7C80\"/></svg>\n"},
        "cmd": ["python3", "{SKILL}/scripts/export_variants.py", "mark.svg", "--web-icons", "--out-dir", "dist"],
        "expect_rc": 0,
        "expect_files": ["dist/favicon.ico", "dist/site.webmanifest", "dist/icon-192.png"]
      },
      {
        "id": "valid_dual_tone_icon_fg_auto_contrast",
        "kind": "valid",
        "requires_bin": "inkscape",
        "files": {"dual.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 256 256\" width=\"256\" height=\"256\"><title>Dual</title><path fill=\"#111827\" d=\"M32 32h192v64H32z\"/><path fill=\"#2563EB\" d=\"M64 112h128v96H64z\"/></svg>\n"},
        "cmd": ["python3", "{SKILL}/scripts/export_variants.py", "dual.svg", "--icon-bg", "#111827", "--icon-fg", "auto", "--only", "app-icon", "--png", "256", "--out-dir", "dist"],
        "expect_rc": 0,
        "expect_files": ["dist/dual-app-icon.svg", "dist/dual-app-icon-256.png"],
        "expect_file_contains": {
          "dist/dual-app-icon.svg": ["fill=\"#ffffff\"", "fill=\"#2563EB\""]
        }
      },
      {
        "id": "valid_readme_lockup_light_dark",
        "kind": "valid",
        "requires_bin": "inkscape",
        "files": {"mark.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 256 256\" width=\"256\" height=\"256\"><title>Clean</title><rect x=\"32\" y=\"32\" width=\"192\" height=\"192\" fill=\"#111827\"/></svg>\n"},
        "cmd": ["python3", "{SKILL}/scripts/readme_lockup.py", "mark.svg", "--title", "Demo Repo", "--tagline", "Fast Tooling", "--card", "--out-dir", "brand"],
        "expect_rc": 0,
        "expect_files": ["brand/demo-repo-banner-light.png", "brand/demo-repo-banner-dark.png", "brand/demo-repo-readme-snippet.md"],
        "expect_in": ["prefers-color-scheme: dark"]
      },
      {
        "id": "valid_readme_custom_lockup_banner",
        "kind": "valid",
        "requires_bin": "inkscape",
        "files": {
          "mark.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 256 256\" width=\"256\" height=\"256\"><title>Mark</title><circle cx=\"128\" cy=\"128\" r=\"80\" fill=\"#111111\"/></svg>\n",
          "lock.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 568 160\" width=\"568\" height=\"160\"><title>Lock</title><circle cx=\"80\" cy=\"80\" r=\"40\" fill=\"#111111\"/><rect x=\"150\" y=\"60\" width=\"340\" height=\"40\" fill=\"#FF4D2D\"/></svg>\n"
        },
        "cmd": ["python3", "{SKILL}/scripts/readme_lockup.py", "mark.svg", "--lockup", "lock.svg", "--title", "Custom Lock", "--card", "--out-dir", "brand"],
        "expect_rc": 0,
        "expect_files": ["brand/custom-lock-banner-light.png", "brand/custom-lock-banner-dark.png"],
        "expect_file_contains": {
          "brand/custom-lock-banner-dark.svg": ["fill=\"#f8fafc\"", "fill=\"#FF4D2D\""]
        }
      },
      {
        "id": "valid_concept_sheet_greyscale_no_filter",
        "kind": "valid",
        "requires_bin": "inkscape",
        "files": {
          "a.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 256 256\" width=\"256\" height=\"256\"><title>A</title><circle cx=\"128\" cy=\"128\" r=\"80\" fill=\"#FF4D2D\"/></svg>\n"
        },
        "cmd": ["python3", "{SKILL}/scripts/concept_sheet.py", "a.svg", "--greyscale", "-o", "concepts.png"],
        "expect_rc": 0,
        "expect_files": ["concepts.svg", "concepts.png"],
        "expect_file_contains": {
          "concepts.svg": ["#717171"]
        }
      },
      {
        "id": "valid_mascot_extract_png_and_ico",
        "kind": "valid",
        "requires_python_mod": "PIL",
        "generators": ["green_strip"],
        "cmd": ["python3", "{SKILL}/scripts/extract_mascot_png.py", "assets/green_strip.png", "--ico", "--outline-px", "4", "--sizes", "128", "--out-dir", "dist"],
        "expect_rc": 0,
        "expect_files": ["dist/green_strip-128.png", "dist/green_strip-favicon.ico"]
      },
      {
        "id": "malformed_mascot_missing_source",
        "kind": "malformed",
        "cmd": ["python3", "{SKILL}/scripts/extract_mascot_png.py", "missing.png"],
        "expect_nonzero": true
      },
      {
        "id": "malformed_missing_symbol_lockup",
        "kind": "malformed",
        "cmd": ["python3", "{SKILL}/scripts/readme_lockup.py", "missing.svg", "--title", "Demo"],
        "expect_nonzero": true
      },
      {
        "id": "valid_search_library_metadata",
        "kind": "valid",
        "cmd": ["python3", "{SKILL}/scripts/search_library.py", "--type", "letterform", "--technique", "negative-space", "--summary"],
        "check_read_only": true,
        "expect_rc": 0,
        "expect_in": ["logos match"]
      }
    ]
  }
}
