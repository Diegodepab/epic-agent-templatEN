{
  "godot-architecture-and-static-audit": {
    "triggers": {
      "positive_keywords": ["uid://", "partial class", "Domain isolation"],
      "negative_keywords": ["pixel metrics"]
    },
    "cases": [
      {
        "id": "valid_clean_project",
        "kind": "clean_fp",
        "files": {
          "project.godot": "[application]\nconfig/name=\"Demo\"\nrun/main_scene=\"res://Main.tscn\"\n",
          "Main.tscn": "[gd_scene format=3]\n[node name=\"Main\" type=\"Node2D\"]\n",
          "Scripts/Player.cs": "using Godot;\npublic partial class Player : Node2D {}\n"
        },
        "cmd": ["python3", "{SKILL}/scripts/check_csharp_godot_architecture.py", "--root", "."],
        "check_read_only": true,
        "expect_rc": 0,
        "expect_in": ["findings=0"]
      },
      {
        "id": "invalid_domain_coupling_caught",
        "kind": "invalid",
        "files": {"Domain/Logic.cs": "using Godot;\npublic class Logic : Node2D {}\n"},
        "cmd": ["python3", "{SKILL}/scripts/check_csharp_godot_architecture.py", "--root", "."],
        "check_read_only": true,
        "expect_rc": 1,
        "expect_in": ["domain-godot-coupling", "missing-partial-class"]
      }
    ]
  },
  "godot-scene-and-input-audit": {
    "triggers": {
      "positive_keywords": ["CollisionLayer", "_Process", "UI focus"],
      "negative_keywords": ["pixel alignment"]
    },
    "cases": [
      {
        "id": "invalid_physics_in_process",
        "kind": "invalid",
        "files": {
          "project.godot": "[application]\nconfig/name=\"Demo\"\n",
          "Scripts/Actor.cs": "using Godot;\nusing System.Collections.Generic;\nusing System.Linq;\npublic partial class Actor : CharacterBody2D {\n  public override void _Process(double d) {\n    MoveAndSlide();\n    var tmp = new List<int>().Where(x => x > 0).ToList();\n    var n = GetNode<Node2D>(\"Sprite\");\n  }\n}\n"
        },
        "cmd": ["python3", "{SKILL}/scripts/audit_scene_and_input.py", "--root", "."],
        "check_read_only": true,
        "expect_rc": 1,
        "expect_in": ["physics-in-process", "per-frame-gc-alloc", "per-frame-linq-alloc", "per-frame-getnode"]
      }
    ]
  },
  "godot-headless-testing": {
    "triggers": {
      "positive_keywords": ["dotnet test", "headless Godot", "ObjectDB"],
      "negative_keywords": ["manual editor"]
    },
    "cases": [
      {
        "id": "missing_godot_must_report_skip_never_pass",
        "kind": "missing_deps",
        "files": {"project.godot": "[application]\nconfig/name=\"Demo\"\n"},
        "env": {"PATH": ""},
        "cmd": ["python3", "{SKILL}/scripts/run_godot_tests.py", "--root", ".", "--json-out", "rep.json"],
        "expect_rc": 0,
        "expect_files": ["rep.json"],
        "expect_in": ["SKIP"],
        "forbid_in": ["PASS"]
      },
      {
        "id": "invalid_require_godot_missing_fails",
        "kind": "invalid",
        "files": {"project.godot": "[application]\nconfig/name=\"Demo\"\n"},
        "env": {"PATH": ""},
        "cmd": ["python3", "{SKILL}/scripts/run_godot_tests.py", "--root", ".", "--require-godot"],
        "expect_rc": 1,
        "expect_in": ["FAIL"]
      }
    ]
  },
  "godot-2d-sprite-and-art-pipeline": {
    "triggers": {
      "positive_keywords": ["sole-Y", "alpha halos", "SpriteFrames"],
      "negative_keywords": ["3D skeletal"]
    },
    "cases": [
      {
        "id": "valid_keyer_and_metrics",
        "kind": "valid",
        "requires_python_mod": "PIL",
        "generators": ["green_strip"],
        "cmd": ["python3", "{SKILL}/scripts/soft_matte_keyer.py", "--out", "keyed", "--bg-color", "green", "--no-crop", "assets/green_strip.png"],
        "expect_rc": 0,
        "expect_files": ["keyed/green_strip.png"]
      },
      {
        "id": "malformed_missing_sheet",
        "kind": "malformed",
        "requires_python_mod": "PIL",
        "cmd": ["python3", "{SKILL}/scripts/audit_spritesheet_metrics.py", "nope.png", "--frame-w", "32", "--frame-h", "32"],
        "expect_nonzero": true
      }
    ]
  },
  "godot-2d-pixel-art-forge": {
    "triggers": {
      "positive_keywords": ["CIELAB", "PixelSpec", "onion-skin"],
      "negative_keywords": ["3D textures"]
    },
    "cases": [
      {
        "id": "valid_render_and_pixel_qa_strict",
        "kind": "valid",
        "requires_python_mod": "PIL",
        "generators": ["slime_copy"],
        "cmd": ["python3", "{SKILL}/scripts/render_pixelspec.py", "--spec", "slime.pixelspec.json", "--out", "out_slime", "--variant", "all"],
        "expect_rc": 0,
        "expect_files": ["out_slime/base/idle_0.png", "out_slime/crimson/idle_0.png"]
      },
      {
        "id": "invalid_partial_alpha_caught",
        "kind": "invalid",
        "requires_python_mod": "PIL",
        "files": {"make_bad.py": "from PIL import Image\nImage.new('RGBA', (8, 8), (255, 0, 0, 128)).save('bad.png')\n"},
        "cmd": ["bash", "-lc", "python3 make_bad.py && python3 {SKILL}/scripts/pixel_qa.py --input bad.png --strict"],
        "expect_rc": 1,
        "expect_in": ["partial_alpha"]
      }
    ]
  },
  "godot-2d-rig-and-fx-animator": {
    "triggers": {
      "positive_keywords": ["SVG bone-rig", "canvas_item", "ambient plate"],
      "negative_keywords": ["3D meshes"]
    },
    "cases": [
      {
        "id": "valid_fx_and_ambient_loop",
        "kind": "valid",
        "requires_python_mod": "PIL",
        "generators": ["plate_png"],
        "files": {
          "amb.json": {
            "schema": "codeart2d.plate_effects.v1",
            "fps": 6,
            "period": 1.0,
            "effects": [{"id": "glow1", "kind": "glow", "polygon": [[0.1, 0.1], [0.9, 0.1], [0.9, 0.9], [0.1, 0.9]], "feather": 0.05, "color": "#ffcc00", "strength": 0.3, "cycles": 1, "period": 1.0}]
          }
        },
        "cmd": ["python3", "{SKILL}/scripts/ambient_bake.py", "--plate", "plate.png", "--spec", "amb.json", "--output-dir", "amb_out"],
        "expect_rc": 0,
        "expect_in": ["\"status\": \"pass\""]
      },
      {
        "id": "valid_rig_animate_inkscape",
        "kind": "valid",
        "requires_bin": "inkscape",
        "requires_python_mod": "PIL",
        "files": {
          "hero.rig.svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"32\" height=\"32\" viewBox=\"0 0 32 32\" data-codeart=\"rig.v1\" data-anchor=\"16 28\" data-ground=\"28\"><g id=\"root\" data-pivot=\"16 28\"><rect x=\"12\" y=\"20\" width=\"8\" height=\"8\" fill=\"#264653\"/><g id=\"head\" data-pivot=\"16 20\"><rect x=\"13\" y=\"10\" width=\"6\" height=\"8\" fill=\"#2a9d8f\"/></g></g></svg>\n",
          "hero.anim.json": {
            "schema": "codeart2d.rig_anim.v1",
            "rig": "hero.rig.svg",
            "clips": {"idle": {"frames": 4, "duration_ms": 150, "loop": true, "tracks": {"head": {"rotate": [[0, -6], [0.5, 6], [1, -6]]}}}}
          }
        },
        "cmd": ["python3", "{SKILL}/scripts/rig_animate.py", "--rig", "hero.rig.svg", "--anim", "hero.anim.json", "--output-dir", "anim_out", "--route", "vector", "--zoom", "1", "--build-clips"],
        "expect_rc": 0,
        "expect_files": ["anim_out/compiled-clips/animation-clips.json"],
        "expect_in": ["\"qa\": \"pass\""]
      },
      {
        "id": "valid_fx_build_and_verify_runtime",
        "kind": "valid",
        "requires_bin": "node",
        "requires_python_mod": "PIL",
        "cmd": ["python3", "{SKILL}/scripts/fx_build.py", "--spec", "{SKILL}/examples/slash.fx.json", "--effects", "slash", "--output-dir", "fx_out", "--build-clips", "--export-runtime", "--strict-qc"],
        "expect_rc": 0,
        "expect_files": ["fx_out/fx-report.json", "fx_out/fx-runtime.mjs", "fx_out/fx-verify.json", "fx_out/compiled-clips/animation-clips.json"],
        "expect_in": ["\"failed_checks\": []"]
      },
      {
        "id": "valid_gait_loop_help",
        "kind": "valid",
        "requires_python_mod": "PIL",
        "cmd": ["python3", "{SKILL}/scripts/gait_loop.py", "--help"],
        "check_read_only": true,
        "expect_rc": 0,
        "expect_in": ["select", "stride"]
      },
      {
        "id": "malformed_rig_spec_rejected_cleanly",
        "kind": "malformed",
        "requires_python_mod": "PIL",
        "files": {"bad.json": {"schema": "broken"}},
        "cmd": ["python3", "{SKILL}/scripts/rig_animate.py", "--anim", "bad.json", "--output-dir", "out"],
        "expect_nonzero": true
      }
    ]
  },
  "godot-2d-autotile-and-parallax": {
    "triggers": {
      "positive_keywords": ["Wang-16", "Parallax2D", "BFS navigation"],
      "negative_keywords": ["3D terrains"]
    },
    "cases": [
      {
        "id": "valid_wang16_and_nav_layout",
        "kind": "valid",
        "requires_python_mod": "PIL",
        "files": {
          "lay.json": {
            "schema": "codeart2d.layout_spec.v1",
            "size": [6, 6],
            "tile_size": 16,
            "materials": {"grass": {"walkable": true, "color": "#55aa55"}},
            "spawns": [{"id": "start", "x": 24, "y": 48}],
            "exits": [{"id": "goal", "edge": "east", "span": [2, 4], "to": "next:start"}]
          }
        },
        "cmd": ["python3", "{SKILL}/scripts/layout_build.py", "--spec", "lay.json", "--output-dir", "map_out", "--strict-qc"],
        "expect_rc": 0,
        "expect_in": ["\"status\": \"pass\""]
      },
      {
        "id": "valid_autotile_build_verify",
        "kind": "valid",
        "requires_python_mod": "PIL",
        "cmd": ["bash", "-lc", "python3 {SKILL}/scripts/autotile_seam_builder.py build --tile-size 16 --out atlas.png && python3 {SKILL}/scripts/autotile_seam_builder.py verify atlas.png --tile-size 16"],
        "expect_rc": 0,
        "expect_files": ["atlas.png"],
        "expect_in": ["mismatches=0"]
      },
      {
        "id": "valid_parallax_build_with_local_validator",
        "kind": "valid",
        "requires_python_mod": "PIL",
        "cmd": ["python3", "{SKILL}/scripts/parallax_build.py", "--spec", "{SKILL}/examples/parallax-gen.json", "--output-dir", "bg_out", "--validate", "--sweep-frames", "3"],
        "expect_rc": 0,
        "expect_files": ["bg_out/parallax-plan.json", "bg_out/parallax-qa.json"],
        "expect_in": ["\"status\": \"pass\""]
      },
      {
        "id": "valid_autotile_build_and_godot_export",
        "kind": "valid",
        "requires_python_mod": "PIL",
        "files": {
          "side_lay.json": {
            "schema": "generate2dmap.layout.v1",
            "groundY": 400,
            "segments": [[0, 640, "ground"], [640, 704, "gap"], [704, 2400, "ground"]],
            "props": [{"id": "crate", "x": 300, "y": 400}],
            "spawns": [{"id": "start", "x": 32, "y": 400}],
            "physics": {"jumpHeight": 72, "jumpDistance": 120, "maxSlopeDeg": 35, "stepUp": 8, "colliderSubstep": 4},
            "viewports": [[1920, 1080], "19.5:9"]
          },
          "lay.json": {
            "schema": "codeart2d.layout_spec.v1",
            "size": [6, 6],
            "tile_size": 16,
            "materials": {"grass": {"walkable": true, "color": "#55aa55"}},
            "spawns": [{"id": "start", "x": 24, "y": 48}],
            "exits": [{"id": "goal", "edge": "east", "span": [2, 4], "to": "next:start"}]
          }
        },
        "cmd": ["bash", "-lc", "python3 {SKILL}/scripts/autotile_build.py --material-spec {SKILL}/examples/water-grass.material.json --kind wang_corner --tile-size 16 --variants 2 --output-dir tiles_out --strict-qc && python3 {SKILL}/scripts/validate_layout.py --layout side_lay.json --output-dir side_out --strict-qc && python3 {SKILL}/scripts/layout_build.py --spec lay.json --output-dir map_out --strict-qc && python3 {SKILL}/scripts/export_godot.py --bundle map_out/map-bundle.json --output-dir godot_out"],
        "expect_rc": 0,
        "expect_files": ["tiles_out/autotile-qa.json", "side_out/layout-report.json", "godot_out/map.tscn"],
        "expect_in": ["\"status\": \"pass\""]
      }
    ]
  },
  "godot-procedural-audio-and-sfx": {
    "triggers": {
      "positive_keywords": ["16-bit WAV", "sound effects", "AudioStreamRandomizer"],
      "negative_keywords": ["adaptive music"]
    },
    "cases": [
      {
        "id": "valid_wav_synth",
        "kind": "valid",
        "requires_python_mod": "numpy",
        "cmd": ["python3", "{SKILL}/scripts/synth_sfx.py", "--preset", "coin", "--variations", "2", "--out-dir", "sfx"],
        "expect_rc": 0,
        "expect_files": ["sfx/coin_01.wav", "sfx/coin_02.wav"]
      },
      {
        "id": "malformed_unknown_preset",
        "kind": "malformed",
        "cmd": ["python3", "{SKILL}/scripts/synth_sfx.py", "--preset", "bad_preset"],
        "expect_nonzero": true
      }
    ]
  },
  "godot-3d-asset-and-rig-qa": {
    "triggers": {
      "positive_keywords": ["GLB/glTF", "3D", "draw-call"],
      "negative_keywords": ["2D pixel"]
    },
    "cases": [
      {
        "id": "valid_glb_passes",
        "kind": "clean_fp",
        "generators": ["glb_valid"],
        "cmd": ["python3", "{SKILL}/scripts/audit_glb_assets.py", "--root", ".", "--max-primitives", "64"],
        "check_read_only": true,
        "expect_rc": 0,
        "expect_in": ["findings=0"]
      },
      {
        "id": "invalid_over_budget_glb_caught",
        "kind": "invalid",
        "generators": ["glb_heavy"],
        "cmd": ["python3", "{SKILL}/scripts/audit_glb_assets.py", "--root", ".", "--max-primitives", "32"],
        "check_read_only": true,
        "expect_rc": 1,
        "expect_in": ["excess-draw-calls"]
      }
    ]
  }
}
